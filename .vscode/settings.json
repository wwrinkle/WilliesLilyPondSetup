{
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "\\.ly$",
        "isAsync": true,
        "cmd": "echo 'formatting ${file}' && ly reformat -i \"${file}\" && echo 'compiling ${file}' && lilypond --output=\"$(dirname \"${file}\")\" \"${file}\""
      }
    ]
  },
  "cSpell.words": ["chordmode"],
  "workbench.colorTheme": "Visual Studio Dark"
}
