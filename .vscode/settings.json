{
  // VSLilyPond Plus (https://github.com/wwrinkle/VSLilyPond-Plus): compile,
  // format on save, errors as you type, MIDI input and playback.
  // Machine-specific settings (LilyPond path, MIDI device, sharps/flats)
  // belong in your user settings, not here.
  "vslilypondPlus.intellisense.enabled": true,
  "vslilypondPlus.compilation.compileOnSave": true,
  // Compile whichever file was saved (output lands next to it).
  "vslilypondPlus.compilation.compileMainFileOnSave": false,
  // Point-and-click links in the PDF power two-way click in the preview.
  "vslilypondPlus.compilation.additionalCommandLineArguments": "-dpoint-and-click",
  // Lets LilyPond find the bundled LV GoldenAge music font (see templates/fonts).
  "vslilypondPlus.compilation.includePaths": [
    "${workspaceFolder}/templates/fonts/lv-goldenage"
  ],
  // Reformats the editor text with python-ly just before saving.
  "vslilypondPlus.formatting.formatOnSave": true,
  "vslilypondPlus.midiInput.relativeMode": true,
  "vslilypondPlus.midiInput.chordMode": false,

  // PDF preview (opens beside the .ly file; click notes to jump to source).
  "lilypond-pdf-preview.general.scale": "page-width",
  "lilypond-pdf-preview.pointAndClick.highlightDuration": 3000,
  "workbench.editorAssociations": {
    "*.pdf": "lilypond.pdf.preview"
  },

  // Keep VS Code's own format-on-save off; VSLilyPond Plus handles it.
  "[lilypond]": {
    "editor.formatOnSave": false
  },

  "cSpell.words": ["chordmode"]
}
